# Cameroon Cancer Foundation - Apache settings for Network Solutions shared hosting.
# (Ignored harmlessly if your plan runs on IIS/Windows instead of Apache.)

AddDefaultCharset UTF-8
# No ErrorDocument here: on Network Solutions the domain is mapped through a subfolder, and
# "ErrorDocument 404 /404.html" resolves against the wrong root and returns a 500 error.
# Answer missing pages with a plain 404 here, so rewrite rules of a parent folder (e.g. another
# WordPress site on the same hosting account) never see them and turn them into a 500 error.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ - [R=404,L]
</IfModule>

# Never serve archives or the project README to visitors (they can contain private settings).
<FilesMatch "(\.zip|\.tar|\.gz|^README\.txt)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_mime.c>
  AddType audio/mpeg .mp3
  AddType image/svg+xml .svg
  AddType application/msword .doc
  AddType application/vnd.openxmlformats-officedocument.wordprocessingml.document .docx
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml text/plain application/xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 1 hour"
  ExpiresByType text/css "access plus 1 day"
  ExpiresByType application/javascript "access plus 1 day"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType audio/mpeg "access plus 1 month"
  ExpiresByType application/pdf "access plus 1 month"
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# --- Force HTTPS ---
# Once an SSL certificate is active on your domain, remove the leading "#"
# from the 5 lines below. Do NOT enable it before https://yourdomain works.
